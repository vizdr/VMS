{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCameraRow",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/cameras"
    },
    {
      "Sid": "WritePirRecordingOnlyOnTheSharedRegistry",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/cameras",
      "Condition": {
        "ForAllValues:StringEquals": {"dynamodb:Attributes": ["cameraId", "pirRecording"]},
        "StringEqualsIfExists": {"dynamodb:ReturnValues": ["NONE", "UPDATED_NEW"]}
      }
    },
    {
      "Sid": "ReadThePisStatusAndClipIndex",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/pir-local"
    },
    {
      "Sid": "RequestUploadsOnly",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/pir-local",
      "Condition": {
        "ForAllValues:StringEquals": {"dynamodb:Attributes": ["cameraId", "sk", "uploadRequestedAt", "requestedBy", "deletedAt"]},
        "StringEqualsIfExists": {"dynamodb:ReturnValues": ["NONE", "UPDATED_NEW"]}
      }
    }
  ]
}
